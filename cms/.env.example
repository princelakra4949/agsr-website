# Copy this to .env.local and fill in your values

# MongoDB Atlas connection string
DATABASE_URI=mongodb+srv://<user>:<password>@<cluster>.mongodb.net/agsr-cms

# A long random secret (generate with: openssl rand -base64 32)
PAYLOAD_SECRET=your-super-secret-key-here

# Your deployed CMS URL (e.g. https://agsr-cms.vercel.app)
NEXT_PUBLIC_SERVER_URL=http://localhost:3000

# Vercel Blob token (for media uploads on Vercel)
# Get from: vercel.com -> Storage -> Blob -> your store -> .env.local
BLOB_READ_WRITE_TOKEN=

# Copy this to .env.local and fill in your values

# MongoDB Atlas connection string
DATABASE_URI=mongodb+srv://<user>:<password>@<cluster>.mongodb.net/agsr-cms

# A long random secret (generate with: openssl rand -base64 32)
PAYLOAD_SECRET=your-super-secret-key-here

# Your deployed CMS URL (e.g. https://agsr-cms.vercel.app)
NEXT_PUBLIC_SERVER_URL=http://localhost:3000

# Vercel Blob token (for media uploads on Vercel)
# Get from: vercel.com -> Storage -> Blob -> your store -> .env.local
BLOB_READ_WRITE_TOKEN=

# Resend (for sending enquiry notification emails)
# Get an API key from: resend.com -> API Keys
RESEND_API_KEY=

# Email address that shows as the "From" on outgoing emails.
# Use onboarding@resend.dev until you verify your own domain in Resend.
RESEND_FROM_ADDRESS=onboarding@resend.dev

# Where enquiry notification emails get sent to
ENQUIRY_NOTIFY_EMAIL=princelakra4949@gmail.com
